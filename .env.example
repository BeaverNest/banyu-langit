# Copy to .env and fill in. Never commit .env.
PORT=3000
DB_PATH=data/trading.db
LOG_LEVEL=info

# When set, /api/v1/* requires the header: x-api-key: <value>
API_KEY=

# Optional: pin responses to a build (freshness payloads echo this back)
CODE_VERSION=

# Optional bridges
BL_DB=
BL_URL=
DENO_SYNC_URL=
# Path to IDX-API's database.sqlite (the bridge reads it read-only).
# Leave unset to auto-detect ./IDX-API-main/data/database.sqlite.
IDX_DB_PATH=

