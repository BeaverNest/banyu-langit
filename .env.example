# Copy to .env and fill in. Never commit .env.
PORT=3000
DB_PATH=data/trading.db
LOG_LEVEL=info

# When set, /api/v1/* requires the header: x-api-key: <value>
API_KEY=

# Optional: pin responses to a build (freshness payloads echo this back)
CODE_VERSION=

# Optional bridges
BL_DB=
BL_URL=
DENO_SYNC_URL=

# Optional fallback market data source
ALPHA_VANTAGE_KEY=
